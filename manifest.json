  function fetchStoredMembers() {
    let bbfMaster = JSON.parse(localStorage.getItem("bbf_master_records_v4") || "[]");
    let bfcMembers = JSON.parse(localStorage.getItem("5BFC_MEMBERS") || "[]");
    let admSync = JSON.parse(localStorage.getItem("5bfc_admissions") || "[]");

    let pool = [...bfcMembers, ...bbfMaster, ...admSync];
    if (pool.length === 0) {
      pool = [...DEFAULT_MASTER_ROSTER];
      localStorage.setItem("5BFC_MEMBERS", JSON.stringify(pool));
    }

    let uniqueMap = new Map();
    pool.forEach(item => {
      let key = (item.phone && item.phone.length > 5) ? item.phone.trim() : item.id;
      if (item.activeInGym !== false && !uniqueMap.has(key)) {
        if (!item.slot) item.slot = "06:00 AM - 07:00 AM";
        if (!item.batch) item.batch = "morning";
        if (!item.attendedDaysCount) item.attendedDaysCount = 0;
        uniqueMap.set(key, item);
      }
    });
    return Array.from(uniqueMap.values());
  }

  function fetchDailyAttendanceMap() {
    return JSON.parse(localStorage.getItem("5bfc_attendance_" + currentDateISO)) || {};
  }

  function openSearchKiosk() {
    document.getElementById("kioskHeroBox").style.display = "none";
    document.getElementById("searchAreaWrapper").style.display = "block";
    document.getElementById("singleMemberContainer").style.display = "none";
    const inp = document.getElementById("memberFilterInput");
    inp.value = "";
    inp.focus();
    document.getElementById("searchDropdownNode").style.display = "none";
  }

  function cancelSearchAndReset() {
    document.getElementById("kioskHeroBox").style.display = "block";
    document.getElementById("searchAreaWrapper").style.display = "none";
    document.getElementById("singleMemberContainer").style.display = "none";
    document.getElementById("memberFilterInput").value = "";
    document.getElementById("searchDropdownNode").style.display = "none";
    currentlyLoadedMember = null;
  }

  function executeKioskSearch() {
    const query = document.getElementById("memberFilterInput").value.trim().toLowerCase();
    const dropdown = document.getElementById("searchDropdownNode");

    if (!query || query.length < 2) {
      dropdown.style.display = "none";
      return;
    }

    const currentShiftIsEve = isCurrentShiftEvening();
    const activeTargetBatch = currentShiftIsEve ? "evening" : "morning";
    const allMembers = fetchStoredMembers();

    const matches = allMembers.filter(m => {
      const shiftMatch = isAdminUnlocked ? true : (m.batch === activeTargetBatch);
      const textMatch = (m.name && m.name.toLowerCase().includes(query)) || (m.phone && m.phone.includes(query));
      return shiftMatch && textMatch;
    });

    if (matches.length > 0) {
      dropdown.style.display = "block";
      dropdown.innerHTML = `<div style="font-size:10px; color:#ffcc00; margin-bottom:5px; font-weight:bold;">मिलते-जुलते सदस्य:</div>`;
      matches.slice(0, 5).forEach(m => {
        const isPaid = (m.status === 'Paid' || m.fees === 'Paid' || m.status === 'Full Paid');
        dropdown.innerHTML += `
          <div class="search-result-item" onclick="loadSingleMemberKioskCard('${m.id}')">
            <div>
              <b style="color:#fff; font-size:12.5px;">${m.name}</b><br>
              <small style="color:#888;">${m.phone} | <span style="color:${isPaid ? '#00ff66' : '#ff4444'}; font-weight:bold;">${isPaid ? 'PAID' : 'DUE'}</span></small>
            </div>
            <button type="button" style="background:#ffcc00; color:#000; border:none; padding:5px 10px; border-radius:6px; font-weight:900; font-size:11px;">लोड करें</button>
          </div>
        `;
      });
    } else {
      dropdown.style.display = "block";
      dropdown.innerHTML = `<div style="color:#ff6666; font-size:11px; text-align:center; padding:8px;">कोई सदस्य नहीं मिला।</div>`;
    }
    }
     function loadSingleMemberKioskCard(memberId) {
    const list = fetchStoredMembers();
    const m = list.find(x => x.id.toString() === memberId.toString());
    if (!m) return;

    currentlyLoadedMember = m;
    const attMap = fetchDailyAttendanceMap();
    const isPresent = !!attMap[m.id];
    const checkin = attMap[m.id];
    const isPaid = (m.status === 'Paid' || m.fees === 'Paid' || m.status === 'Full Paid');

    let expStr = "N/A";
    let daysRem = 0;
    if (m.joinDate) {
      const jD = new Date(m.joinDate);
      const expD = new Date(jD);
      expD.setMonth(expD.getMonth() + (m.planMonths || 1));
      expStr = formatDateToDDMMYYYY(expD.toISOString().split("T")[0]);
      daysRem = Math.max(0, Math.ceil((expD - new Date()) / (1000 * 60 * 60 * 24)));
    }

    document.getElementById("cardMemberName").innerText = m.name;
    document.getElementById("cardMemberPhone").innerText = `📞 +91 ${m.phone}`;
    
    const feeBadge = document.getElementById("cardFeeBadge");
    feeBadge.className = `fee-pill-tag ${isPaid ? 'fee-paid' : 'fee-due'}`;
    feeBadge.innerText = isPaid ? 'FEES PAID' : 'FEES DUE';

    document.getElementById("cardPlanText").innerText = `${m.plan || 'सामान्य (General Fitness - ₹500/माह)'}`;
    document.getElementById("cardJoinDate").innerText = formatDateToDDMMYYYY(m.joinDate);
    document.getElementById("cardLastPaid").innerText = formatDateToDDMMYYYY(m.lastPaid || m.joinDate);
    document.getElementById("cardExpiryDate").innerText = expStr;
    document.getElementById("cardDaysRemaining").innerText = daysRem;
    document.getElementById("cardSlotDisplay").innerText = m.slot || "06:00 AM - 07:00 AM";

    const proofBox = document.getElementById("cardProofContainer");
    if (isPresent && checkin) {
      proofBox.innerHTML = `
        <div class="compact-proof-badge">
          <img src="${checkin.photo}" alt="Seal">
          <span>✔ VERIFIED BIOMETRIC SEAL | ${checkin.time}</span>
        </div>
      `;
    } else {
      proofBox.innerHTML = "";
    }

    const btnPres = document.getElementById("btnPresTrigger");
    btnPres.className = `btn-pres-action ${isPresent ? 'is-ver' : 'not-ver'}`;
    btnPres.innerText = isPresent ? '✔ ATTENDANCE VERIFIED' : '📸 PRESENT दर्ज करें';

    document.getElementById("activeLoadedCard").className = `loaded-member-card ${isPresent ? 'status-present' : ''}`;
    document.getElementById("searchAreaWrapper").style.display = "none";
    document.getElementById("singleMemberContainer").style.display = "block";
  }

  function handleAttendanceClick() {
    if (!currentlyLoadedMember) return;
    initiateCameraVerification(currentlyLoadedMember);
  }

  function initiateCameraVerification(candidate) {
    document.getElementById("modalCandidateName").innerText = candidate.name;
    document.getElementById("cameraBackdropModal").classList.add("show");

    const videoElem = document.getElementById("videoElement");
    navigator.mediaDevices.getUserMedia({ video: { facingMode: "user" }, audio: false })
      .then(stream => {
        currentVideoStream = stream;
        videoElem.srcObject = stream;
      })
      .catch(err => {
        alert("कैमरा परमिशन नहीं मिली!");
        closeCameraModal();
      });
  }

  const athleteQuotes = [
    "आप इस जिम के सबसे परफॉर्मिंग और अनुशासित एथलीट हैं! 🔥",
    "लोहे को आकार देने वाला असली जिद्दी खिलाड़ी यही है! 💪",
    "पसीना बहाना ही आपकी सबसे बड़ी ताकत है, लगे रहो भाई! ⚡",
    "जिसकी मेहनत बोलती है, उसका रिकॉर्ड हमेशा टॉप पर रहता है! 🌟",
    "तोर फोड़ जारी रखो, फिटनेस का असली राजा यही है! 🚀"
  ];
  function captureLiveSelfieProof() {
    const videoElem = document.getElementById("videoElement");
    const canvas = document.getElementById("offscreenCanvas");
    
    if (!videoElem || videoElem.readyState !== videoElem.HAVE_ENOUGH_DATA) {
      alert("कैमरा लोड हो रहा है, कृपया प्रतीक्षा करें!");
      return;
    }

    canvas.width = videoElem.videoWidth || 320;
    canvas.height = videoElem.videoHeight || 320;
    const ctx = canvas.getContext("2d");
    ctx.translate(canvas.width, 0); ctx.scale(-1, 1);
    ctx.drawImage(videoElem, 0, 0, canvas.width, canvas.height);

    const now = new Date();
    const base64Stamp = canvas.toDataURL("image/jpeg", 0.8);
    const dayStr = `${now.getDate() < 10 ? '0'+now.getDate() : now.getDate()}-${(now.getMonth()+1) < 10 ? '0'+(now.getMonth()+1) : (now.getMonth()+1)}-${now.getFullYear()}`;
    const timeStr = now.toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true });

    let attendanceRecords = fetchDailyAttendanceMap();
    attendanceRecords[currentlyLoadedMember.id] = { time: timeStr, fullStamp: `📅 ${dayStr} | ⏰ ${timeStr}`, photo: base64Stamp };
    localStorage.setItem("5bfc_attendance_" + currentDateISO, JSON.stringify(attendanceRecords));

    let allRecords = fetchStoredMembers();
    let target = allRecords.find(r => r.id.toString() === currentlyLoadedMember.id.toString());
    let currentAttended = 1;
    let daysRem = 0;
    let expiryStr = "N/A";

    if (target) {
      target.attendedDaysCount = (target.attendedDaysCount || 0) + 1;
      currentAttended = target.attendedDaysCount;

      if (target.joinDate) {
        const jD = new Date(target.joinDate);
        const expD = new Date(jD);
        expD.setMonth(expD.getMonth() + (target.planMonths || 1));
        expiryStr = formatDateToDDMMYYYY(expD.toISOString().split("T")[0]);
        daysRem = Math.max(0, Math.ceil((expD - now) / (1000 * 60 * 60 * 24)));
      }
      syncAllStorage(allRecords);
    }

    closeCameraModal();

    const randomQuote = athleteQuotes[Math.floor(Math.random() * athleteQuotes.length)];
    document.getElementById("celebrateMemberName").innerText = `THANK YOU ${currentlyLoadedMember.name.toUpperCase()}!`;
    document.getElementById("celebrateAttendedDays").innerText = `इस महीने कुल ${currentAttended} दिन आ चुके हैं`;
    document.getElementById("celebrateRemainingDaysBig").innerText = `⏳ महीना पूरा होने में ${daysRem} दिन शेष हैं!`;
    document.getElementById("celebrateExpiryDateBox").innerText = `पैकेज समाप्ति तिथि: ${expiryStr}`;
    document.getElementById("dynamicOfferProgressBox").innerHTML = `🔥 <b>एथलीट स्टेटस:</b> "${randomQuote}"`;

    document.getElementById("attendanceCelebrationModal").classList.add("show");
  }

  function completeAttendanceAndResetKiosk() {
    closeModal('attendanceCelebrationModal');
    cancelSearchAndReset();
  }

  function openAdminMemberManager(memberId) {
    let pin = prompt("🔒 5 BFC Admin PIN दर्ज करें (अटेंडेंस और पैकेज बदलने हेतु):");
    if (pin !== ADMIN_PIN) {
      if(pin !== null) alert("❌ गलत पिन!");
      return;
    }

    let allRecords = fetchStoredMembers();
    let m = allRecords.find(r => r.id.toString() === memberId.toString());
    if (!m) { alert("सदस्य नहीं मिला!"); return; }

    let modal = document.getElementById("adminMemberManagerModal");
    if (!modal) {
      modal = document.createElement("div");
      modal.id = "adminMemberManagerModal";
      modal.style.cssText = "position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.92); z-index:99999; display:flex; justify-content:center; align-items:center; padding:15px; box-sizing:border-box;";
      document.body.appendChild(modal);
    }

    const now = new Date();
    const year = now.getFullYear();
    const month = now.getMonth();
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    const monthName = now.toLocaleString('hi-IN', { month: 'long' });

    let calendarHTML = '';
    for (let d = 1; d <= daysInMonth; d++) {
      let dayISO = `${year}-${(month+1) < 10 ? '0'+(month+1) : (month+1)}-${d < 10 ? '0'+d : d}`;
      let dayDisplay = `${d < 10 ? '0'+d : d}-${(month+1) < 10 ? '0'+(month+1) : (month+1)}-${year}`;
      let dayMap = JSON.parse(localStorage.getItem("5bfc_attendance_" + dayISO) || "{}");
      let isPresent = dayMap[m.id] ? true : false;

      calendarHTML += `
        <label style="background:#181818; border:1px solid ${isPresent ? '#00ff66' : '#444'}; padding:6px; border-radius:6px; display:flex; justify-content:space-between; align-items:center; margin-bottom:5px; font-size:11px; cursor:pointer;">
          <span style="display:flex; align-items:center; gap:6px;">
            <input type="checkbox" class="admin-date-checkbox" value="${dayISO}" style="width:15px; height:15px; cursor:pointer;">
            📅 <b>${dayDisplay}</b>
          </span>
          <span style="color:${isPresent ? '#00ff66' : '#ff4444'}; font-weight:bold;">${isPresent ? '✅ Present' : '❌ Absent'}</span>
        </label>
      `;
    }

    const isCurrentPaid = (m.status === 'Paid' || m.fees === 'Paid' || m.status === 'Full Paid');

    modal.innerHTML = `
      <div style="background:#111; border:2px solid #ffcc00; border-radius:14px; max-width:460px; width:100%; padding:16px; color:#fff; max-height:90vh; overflow-y:auto; box-sizing:border-box;">
        <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #333; padding-bottom:8px; margin-bottom:10px;">
          <h3 style="color:#ffcc00; margin:0; font-size:15px;">⚙️ एडमिन कंट्रोल: ${m.name}</h3>
          <button onclick="document.getElementById('adminMemberManagerModal').style.display='none'" style="background:#333; color:#fff; border:none; padding:4px 8px; border-radius:4px; cursor:pointer;">✕</button>
        </div>

        <div style="background:#1f1f1f; padding:10px; border-radius:8px; margin-bottom:10px;">
          <div style="font-size:11.5px; color:#ffcc00; font-weight:bold; margin-bottom:5px;">📦 पैकेज व प्लान बदलें (5 Plans):</div>
          <select id="adminNewPlanSelect" style="width:100%; background:#000; border:1px solid #555; color:#fff; padding:7px; border-radius:6px; font-size:11px; margin-bottom:6px;">
            <option value="🔥 7 दिन का ट्रायल (7 Days Trial - ₹99)">🔥 7 दिन का ट्रायल (7 Days Trial - ₹99)</option>
            <option value="विद्यार्थी (Student Offer - ₹300/माह)">विद्यार्थी (Student Offer - ₹300/माह)</option>
            <option value="युवा / गैर-नौकरीपेशा (Job Seeker - ₹400/माह)">युवा / गैर-नौकरीपेशा (Job Seeker - ₹400/माह)</option>
            <option value="सामान्य (General Fitness - ₹500/माह)" selected>सामान्य (General Fitness - ₹500/माह)</option>
            <option value="🔥 3000 स्पेशल पैकेज (₹100 वर्किंग-डे ऑफ़ - ₹2900)">🔥 3000 स्पेशल पैकेज (₹100 वर्किंग-डे ऑफ़ - ₹2900)</option>
          </select>
          <button onclick="saveAdminMemberPlan('${m.id}')" style="background:#ffcc00; color:#000; border:none; padding:6px 12px; border-radius:6px; font-size:11px; font-weight:bold; cursor:pointer;">💾 प्लान अपडेट करें</button>
        </div>

        <div style="background:#1f1f1f; padding:10px; border-radius:8px; margin-bottom:10px;">
          <div style="font-size:11.5px; color:#ffcc00; font-weight:bold; margin-bottom:5px;">💰 फीस स्थिति (Fee Status Control):</div>
          <select id="adminFeeStatusSelect" style="width:100%; background:#000; border:1px solid #555; color:#fff; padding:7px; border-radius:6px; font-size:11px; margin-bottom:6px;">
            <option value="Paid" ${isCurrentPaid ? 'selected' : ''}>✅ Paid (फीस जमा है)</option>
            <option value="Due" ${!isCurrentPaid ? 'selected' : ''}>❌ Due (फीस बकाया है)</option>
          </select>
          <button onclick="saveAdminFeeStatus('${m.id}')" style="background:#00ff66; color:#000; border:none; padding:6px 12px; border-radius:6px; font-size:11px; font-weight:bold; cursor:pointer;">💾 फीस स्टेटस अपडेट करें</button>
        </div>

        <div style="font-size:11.5px; color:#ffcc00; font-weight:bold; margin-bottom:5px;">📅 ${monthName} ${year} - मल्टीपल डेट्स चुनें:</div>
        <div style="max-height:150px; overflow-y:auto; border:1px solid #333; padding:6px; border-radius:6px; margin-bottom:10px;">
          ${calendarHTML}
        </div>

        <div style="display:flex; gap:8px; margin-bottom:10px;">
          <button onclick="applyBatchAttendance('${m.id}', true)" style="flex:1; background:#00ff66; color:#000; font-weight:bold; padding:8px; border:none; border-radius:6px; cursor:pointer; font-size:10.5px;">✅ सिलेक्टेड को Present करें</button>
          <button onclick="applyBatchAttendance('${m.id}', false)" style="flex:1; background:#ff4444; color:#fff; font-weight:bold; padding:8px; border:none; border-radius:6px; cursor:pointer; font-size:10.5px;">❌ सिलेक्टेड को Absent करें</button>
        </div>

        <button onclick="document.getElementById('adminMemberManagerModal').style.display='none'; location.reload();" style="width:100%; background:#333; color:#fff; font-weight:bold; padding:9px; border:none; border-radius:8px; cursor:pointer; font-size:12px;">✔ सहेजें और बंद करें (DONE)</button>
      </div>
    `;
    modal.style.display = "flex";
  }
      function applyBatchAttendance(memberId, makePresent) {
    const checkboxes = document.querySelectorAll(".admin-date-checkbox:checked");
    if (checkboxes.length === 0) {
      alert("⚠️ कृपया कम से कम एक तारीख (Date) टिक (Select) करें!");
      return;
    }

    checkboxes.forEach(chk => {
      let dateISO = chk.value;
      let dayMap = JSON.parse(localStorage.getItem("5bfc_attendance_" + dateISO) || "{}");
      if (makePresent) {
        dayMap[memberId] = { time: "07:00 AM (Admin)", fullStamp: `📅 ${dateISO} | ⏰ Manual`, photo: "" };
      } else {
        delete dayMap[memberId];
      }
      localStorage.setItem("5bfc_attendance_" + dateISO, JSON.stringify(dayMap));
    });

    alert(`✅ सफलतापूर्वक ${checkboxes.length} तारीखों की अटेंडेंस अपडेट कर दी गई है!`);
    openAdminMemberManager(memberId);
  }

  function saveAdminMemberPlan(memberId) {
    let allRecords = fetchStoredMembers();
    let m = allRecords.find(r => r.id.toString() === memberId.toString());
    if (!m) return;
    m.plan = document.getElementById("adminNewPlanSelect").value;
    syncAllStorage(allRecords);
    alert("✅ पैकेज सफलतापूर्वक अपडेट कर दिया गया है!");
    document.getElementById('adminMemberManagerModal').style.display = 'none';
    location.reload();
  }

  function saveAdminFeeStatus(memberId) {
    let allRecords = fetchStoredMembers();
    let m = allRecords.find(r => r.id.toString() === memberId.toString());
    if (!m) return;
    let newStatus = document.getElementById("adminFeeStatusSelect").value;
    m.status = newStatus === 'Paid' ? 'Paid' : 'Pending';
    m.fees = newStatus;
    syncAllStorage(allRecords);
    alert("✅ फीस स्टेटस सफलतापूर्वक अपडेट कर दिया गया है!");
    document.getElementById('adminMemberManagerModal').style.display = 'none';
    loadSingleMemberKioskCard(m.id);
  }

  function openSlotChangerModal() {
    let pin = prompt("🔒 Admin PIN दर्ज करें:");
    if (pin !== ADMIN_PIN) {
      alert("❌ गलत PIN!");
      return;
    }
    document.getElementById("slotChangerMemberName").innerText = `सदस्य: ${currentlyLoadedMember.name}`;
    document.getElementById("slotChangerModal").classList.add("show");
  }

  function saveNewMemberSlot(newSlot, batchType) {
    if (!currentlyLoadedMember) return;
    let records = fetchStoredMembers();
    let target = records.find(r => r.id.toString() === currentlyLoadedMember.id.toString());
    if (target) {
      target.slot = newSlot;
      target.batch = batchType;
      syncAllStorage(records);
      currentlyLoadedMember = target;
      alert(`✅ स्लॉट अपडेट हो गया!`);
      closeModal('slotChangerModal');
      loadSingleMemberKioskCard(target.id);
    }
  }

  function unlockAdminControl() {
    let pin = prompt("🔒 Admin PIN दर्ज करें:");
    if (pin === ADMIN_PIN) {
      isAdminUnlocked = true;
      alert("✅ Admin Access अनलॉक हो गया!");
    }
  }

  function syncAllStorage(records) {
    localStorage.setItem("5BFC_MEMBERS", JSON.stringify(records));
    localStorage.setItem("bbf_master_records_v4", JSON.stringify(records));
    localStorage.setItem("5bfc_admissions", JSON.stringify(records));
  }

  function closeCameraModal() {
    if (currentVideoStream) {
      currentVideoStream.getTracks().forEach(t => t.stop());
      currentVideoStream = null;
    }
    document.getElementById("cameraBackdropModal").classList.remove("show");
  }

  function closeModal(id) {
    document.getElementById(id).classList.remove("show");
  }

  window.onload = () => {
    runLiveSystemClock();
    setInterval(runLiveSystemClock, 1000);
  };
</script>
</body>
</html>
    
