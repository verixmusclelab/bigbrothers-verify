<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>5 Brother's Fitness Club — Main Menu</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  body{
    background:#050505;color:#fff;font-family:system-ui,-apple-system,sans-serif;
    min-height:100vh;padding:16px;
  }
  .wrap{max-width:480px;margin:0 auto}
  header{text-align:center;margin:12px 0 20px}
  header h1{color:#ffcc00;font-size:18px;letter-spacing:.5px}
  header p{color:#888;font-size:11px;margin-top:4px}
  .grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  a.tile{
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    gap:8px;min-height:110px;padding:14px 10px;
    background:#111;border:1.5px solid #333;border-radius:14px;
    text-decoration:none;color:#fff;font-weight:700;font-size:12px;
    transition:border-color .15s, transform .1s;
  }
  a.tile:active{transform:scale(.97)}
  a.tile .ico{font-size:28px;line-height:1}
  a.tile.gold{border-color:#ffcc00;background:#1a1600}
  a.tile.green{border-color:#00ff66;background:#0a1a10}
  a.tile.blue{border-color:#4db8ff;background:#0a1520}
  a.tile.orange{border-color:#ff9900;background:#1a1000}
  a.tile.red{border-color:#ff5555;background:#1a0808}
  a.tile.wa{border-color:#25D366;background:#0a1a10}
  .sub{font-size:10px;color:#888;font-weight:500;text-align:center}
  footer{text-align:center;margin-top:24px;color:#555;font-size:10px}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <h1>5 BROTHER'S FITNESS CLUB</h1>
    <p>उमराव खेड़ा, अकरमपुर, उन्नाव · 9140417259</p>
    <p style="color:#ffcc00;margin-top:6px;font-weight:700;font-size:12px">मुख्य मेन्यू (Main Menu)</p>
  </header>

  <div class="grid">
    <!-- Admission Form -->
    <a class="tile gold" href="admission.html">
      <span class="ico">📝</span>
      Admission Form
      <span class="sub">नया सदस्य / फॉर्म</span>
    </a>

    <!-- Members Portal (Fixed filename) -->
    <a class="tile blue" href="Members_Portal.html">
      <span class="ico">👥</span>
      Members Portal
      <span class="sub">Student · Job · Edit · Lock</span>
    </a>

    <!-- Fees Portal (Fixed filename) -->
    <a class="tile green" href="Fees_Portal_Fixed.html">
      <span class="ico">💰</span>
      Fees Portal
      <span class="sub">फीस जमा / रसीद</span>
    </a>

    <!-- Attendance Kiosk (Fixed filename) -->
    <a class="tile orange" href="Attendance_Kiosk_Fixed.html">
      <span class="ico">✅</span>
      Attendance
      <span class="sub">हाजिरी / Selfie</span>
    </a>

    <!-- Master Dashboard (Fixed filename) -->
    <a class="tile" href="Master_Dashboard_Fixed.html">
      <span class="ico">👑</span>
      Master
      <span class="sub">Admin dashboard</span>
    </a>

    <!-- Supplement Store -->
    <a class="tile" href="BigBrothers_Fitness_Store_Fixed.html">
      <span class="ico">🛒</span>
      Supplement Store
      <span class="sub">Products / Shop</span>
    </a>

    <!-- Product Verify -->
    <a class="tile wa" href="verify.html">
      <span class="ico">🔐</span>
      Product Verify
      <span class="sub">Code check</span>
    </a>

    <!-- Pay / UPI -->
    <a class="tile red" href="pay.html">
      <span class="ico">📲</span>
      Pay / UPI
      <span class="sub">Payment page</span>
    </a>
  </div>

  <footer>
    5 Brother's Fitness Club · Internal Use
  </footer>
</div>
</body>
</html>
