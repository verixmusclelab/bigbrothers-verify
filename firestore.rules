rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Firebase Auth se login ke baad hi true
      return request.auth != null;
    }

    // Members — sirf logged-in admin
    match /members/{memberId} {
      allow read, write: if isAdmin();
    }

    // Ex-members (rejoin archive)
    match /ex_members/{memberId} {
      allow read, write: if isAdmin();
    }

    // Attendance — admin only
    match /attendance/{dateId} {
      allow read, write: if isAdmin();
    }

    // Payment proofs:
    // Customer (bina login) sirf naya proof bhej sakta hai — limited fields
    // Read / approve sirf admin
    match /payment_proofs/{proofId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'name', 'phone', 'amount', 'utr', 'image', 'memberId',
          'paidDate', 'months', 'planBase', 'catVal', 'createdAt',
          'checked', 'status'
        ])
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.utr is string
        && request.resource.data.checked == false
        && (!('status' in request.resource.data)
            || request.resource.data.status in ['pending', 'submitted']);

      allow read, update, delete: if isAdmin();
    }

    // Diet / store orders — admin only (agar use ho)
    match /diet_orders/{id} {
      allow read, write: if isAdmin();
    }
    match /store_orders/{id} {
      allow read, write: if isAdmin();
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
