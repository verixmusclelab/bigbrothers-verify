rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function master() { return signed() && request.auth.token.masterAdmin == true; }
    function hasUser() { return signed() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function userData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role() {
      return signed() && request.auth.token.role != null
        ? request.auth.token.role
        : (hasUser() ? userData().role : '');
    }
    function myGym() {
      return signed() && request.auth.token.gymId != null
        ? request.auth.token.gymId
        : (hasUser() && userData().gymId != null ? userData().gymId : request.auth.uid);
    }
    function sameGym(g) { return master() || (signed() && g is string && myGym() == g); }
    function ownerOf(g) { return master() || (signed() && myGym() == g && (request.auth.uid == g || role() == 'owner')); }
    function managerOf(g) { return signed() && myGym() == g && role() == 'manager'; }
    function staffOf(g) { return signed() && myGym() == g && role() == 'staff'; }
    function branchMatches(data) {
      return role() != 'manager' || (request.auth.token.branchId != null && data.branchId == request.auth.token.branchId);
    }
    function hasPlan(g, minimum) {
      return master() || (
        exists(/databases/$(database)/documents/subscriptions/$(g))
        && get(/databases/$(database)/documents/subscriptions/$(g)).data.status == 'active'
        && get(/databases/$(database)/documents/subscriptions/$(g)).data.amount >= minimum
        && (!get(/databases/$(database)/documents/subscriptions/$(g)).data.keys().hasAny(['expiresAt'])
          || get(/databases/$(database)/documents/subscriptions/$(g)).data.expiresAt > request.time)
      );
    }
    function managerOrOwner(g, data) {
      return ownerOf(g) || (managerOf(g) && branchMatches(data));
    }

    match /owner_accounts/{uid} {
      allow create: if signed() && request.auth.uid == uid;
      allow read: if master() || (signed() && request.auth.uid == uid);
      allow update: if master() || (signed() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','gymId','masterAdmin']));
      allow delete: if master();
    }

    match /gyms/{gymId} {
      allow read: if sameGym(gymId);
      allow create: if master() || (signed() && request.auth.uid == gymId);
      allow update, delete: if ownerOf(gymId);
    }

    match /subscriptions/{gymId} {
      allow read: if sameGym(gymId);
      allow write: if master();
    }

    match /plan_requests/{uid} {
      allow create: if signed() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.gymId == myGym()
        && request.resource.data.status == 'pending';
      allow read: if master() || (signed() && request.auth.uid == uid) || ownerOf(resource.data.gymId);
      allow update: if master() || (signed() && request.auth.uid == uid
        && resource.data.gymId == myGym()
        && request.resource.data.status == 'pending'
        && request.resource.data.gymId == resource.data.gymId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['planName','amount','requestedAt','source','gymId','uid','status']));
      allow delete: if master();
    }

    match /users/{uid} {
      allow create: if signed() && (master() || (ownerOf(request.resource.data.gymId)
        && request.resource.data.role in ['manager','staff']));
      allow read: if master() || (signed() && request.auth.uid == uid)
        || ownerOf(resource.data.gymId) || (managerOf(resource.data.gymId) && branchMatches(resource.data));
      allow update: if master() || ownerOf(resource.data.gymId)
        || (signed() && request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','gymId','branchId','permissions']));
      allow delete: if master() || ownerOf(resource.data.gymId);
    }

    match /members/{id} {
      allow read: if hasPlan(resource.data.gymId, 99) && managerOrOwner(resource.data.gymId, resource.data);
      allow create: if hasPlan(request.resource.data.gymId, 99)
        && (ownerOf(request.resource.data.gymId) || (managerOf(request.resource.data.gymId) && branchMatches(request.resource.data)));
      allow update: if hasPlan(resource.data.gymId, 99)
        && (ownerOf(resource.data.gymId) || (managerOf(resource.data.gymId) && branchMatches(resource.data)))
        && request.resource.data.gymId == resource.data.gymId
        && (role() != 'manager' || branchMatches(request.resource.data));
      allow delete: if hasPlan(resource.data.gymId, 99) && ownerOf(resource.data.gymId);
    }

    match /public_members/{id} {
      allow read: if hasPlan(resource.data.gymId, 99) && managerOrOwner(resource.data.gymId, resource.data);
      allow create: if hasPlan(request.resource.data.gymId, 99) && ownerOf(request.resource.data.gymId);
      allow update: if hasPlan(resource.data.gymId, 99)
        && (ownerOf(resource.data.gymId) || (managerOf(resource.data.gymId) && branchMatches(resource.data)));
      allow delete: if hasPlan(resource.data.gymId, 99) && ownerOf(resource.data.gymId);
    }

    match /admissions/{id} {
      allow read: if hasPlan(resource.data.gymId, 99) && managerOrOwner(resource.data.gymId, resource.data);
      allow create: if hasPlan(request.resource.data.gymId, 99)
        && (ownerOf(request.resource.data.gymId) || (managerOf(request.resource.data.gymId) && branchMatches(request.resource.data)));
      allow update: if hasPlan(resource.data.gymId, 99)
        && (ownerOf(resource.data.gymId) || (managerOf(resource.data.gymId) && branchMatches(resource.data)));
      allow delete: if hasPlan(resource.data.gymId, 99) && ownerOf(resource.data.gymId);
    }

    match /attendance/{id} {
      allow read: if hasPlan(resource.data.gymId, 99) && (
        ownerOf(resource.data.gymId)
        || (managerOf(resource.data.gymId) && branchMatches(resource.data))
        || (staffOf(resource.data.gymId) && resource.data.uid == request.auth.uid)
      );
      allow create: if hasPlan(request.resource.data.gymId, 99) && (
        ownerOf(request.resource.data.gymId)
        || (managerOf(request.resource.data.gymId) && branchMatches(request.resource.data))
        || (staffOf(request.resource.data.gymId) && request.resource.data.uid == request.auth.uid)
      );
      allow update: if hasPlan(resource.data.gymId, 99)
        && (ownerOf(resource.data.gymId) || (managerOf(resource.data.gymId) && branchMatches(resource.data)));
      allow delete: if hasPlan(resource.data.gymId, 99) && ownerOf(resource.data.gymId);
    }

    match /attendance_attempts/{id} {
      allow read: if hasPlan(resource.data.gymId, 99) && (
        ownerOf(resource.data.gymId)
        || (managerOf(resource.data.gymId) && branchMatches(resource.data))
        || (staffOf(resource.data.gymId) && resource.data.uid == request.auth.uid)
      );
      allow create: if hasPlan(request.resource.data.gymId, 99)
        && sameGym(request.resource.data.gymId)
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if hasPlan(resource.data.gymId, 99) && ownerOf(resource.data.gymId);
    }

    match /ex_members/{id} {
      allow read: if hasPlan(resource.data.gymId, 99) && managerOrOwner(resource.data.gymId, resource.data);
      allow create, update: if hasPlan(request.resource.data.gymId, 99)
        && (ownerOf(request.resource.data.gymId) || (managerOf(request.resource.data.gymId) && branchMatches(request.resource.data)));
      allow delete: if hasPlan(resource.data.gymId, 99) && ownerOf(resource.data.gymId);
    }

    match /staff/{id} {
      allow read: if hasPlan(resource.data.gymId, 399) && (
        ownerOf(resource.data.gymId)
        || (managerOf(resource.data.gymId) && branchMatches(resource.data))
        || (staffOf(resource.data.gymId) && resource.data.uid == request.auth.uid)
      );
      allow create: if hasPlan(request.resource.data.gymId, 399)
        && (ownerOf(request.resource.data.gymId) || (managerOf(request.resource.data.gymId) && branchMatches(request.resource.data)));
      allow update: if hasPlan(resource.data.gymId, 399)
        && (ownerOf(resource.data.gymId) || (managerOf(resource.data.gymId) && branchMatches(resource.data)))
        && request.resource.data.gymId == resource.data.gymId;
      allow delete: if hasPlan(resource.data.gymId, 399) && ownerOf(resource.data.gymId);
    }

    match /staff_docs/{id} {
      allow read: if hasPlan(resource.data.gymId, 399) && (
        ownerOf(resource.data.gymId)
        || (managerOf(resource.data.gymId) && branchMatches(resource.data))
        || (staffOf(resource.data.gymId) && resource.data.uid == request.auth.uid)
      );
      allow create: if hasPlan(request.resource.data.gymId, 399)
        && (ownerOf(request.resource.data.gymId) || (managerOf(request.resource.data.gymId) && branchMatches(request.resource.data)));
      allow update: if hasPlan(resource.data.gymId, 399)
        && (ownerOf(resource.data.gymId) || (managerOf(resource.data.gymId) && branchMatches(resource.data)))
        && request.resource.data.gymId == resource.data.gymId;
      allow delete: if hasPlan(resource.data.gymId, 399) && ownerOf(resource.data.gymId);
    }

    match /staffatt/{id} {
      allow read: if hasPlan(resource.data.gymId, 199) && (
        ownerOf(resource.data.gymId)
        || (managerOf(resource.data.gymId) && branchMatches(resource.data))
        || (staffOf(resource.data.gymId) && resource.data.uid == request.auth.uid)
      );
      allow create: if hasPlan(request.resource.data.gymId, 199)
        && sameGym(request.resource.data.gymId)
        && request.resource.data.uid == request.auth.uid;
      allow update: if hasPlan(resource.data.gymId, 199)
        && (ownerOf(resource.data.gymId) || (managerOf(resource.data.gymId) && branchMatches(resource.data)));
      allow delete: if hasPlan(resource.data.gymId, 199) && ownerOf(resource.data.gymId);
    }

    match /leaves/{id} {
      allow create: if hasPlan(request.resource.data.gymId, 199) && signed()
        && request.resource.data.uid == request.auth.uid
        && sameGym(request.resource.data.gymId);
      allow read: if hasPlan(resource.data.gymId, 199) && (
        ownerOf(resource.data.gymId)
        || (managerOf(resource.data.gymId) && branchMatches(resource.data))
        || (staffOf(resource.data.gymId) && resource.data.uid == request.auth.uid)
      );
      allow update: if hasPlan(resource.data.gymId, 199)
        && (ownerOf(resource.data.gymId) || (managerOf(resource.data.gymId) && branchMatches(resource.data)));
      allow delete: if hasPlan(resource.data.gymId, 199) && ownerOf(resource.data.gymId);
    }

    match /complaints/{id} {
      allow create: if hasPlan(request.resource.data.gymId, 499) && staffOf(request.resource.data.gymId)
        && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if ownerOf(resource.data.gymId);
    }

    match /mobiles/{id} {
      allow read: if hasPlan(resource.data.gymId, 99) && managerOrOwner(resource.data.gymId, resource.data);
      allow create: if hasPlan(request.resource.data.gymId, 99)
        && (ownerOf(request.resource.data.gymId) || (managerOf(request.resource.data.gymId) && branchMatches(request.resource.data)));
      allow update, delete: if hasPlan(resource.data.gymId, 99) && ownerOf(resource.data.gymId);
    }

    // No blanket public access. All other collections are denied except to Master Admin.
    match /{document=**} { allow read, write: if master(); }
  }
}
